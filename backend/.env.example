# 环境配置文件示例
# 复制此文件为 .env 并填入实际值

# 服务器配置
# 8080 与 config/index.js 默认值、miniprogram/utils/request.js 的 BASE_URL 保持一致
PORT=8080
NODE_ENV=development

# CORS 白名单（逗号分隔；'*' 全放；空 + NODE_ENV=production 拒绝所有跨域）
# 例：ALLOWED_ORIGINS=https://example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# AI 限流开关（1=关；空=开）。压测/联调时设 1 临时绕开
RATE_LIMIT_DISABLED=

# MongoDB配置
MONGODB_URL=mongodb://localhost:27017/bazi

# Redis配置
REDIS_URL=redis://localhost:6379

# RAG 配置(LightRAG 端点,可选;挂了不影响产品解读,只是没引证)
# 启动方式见 bazi-skill-dist/scripts/serve-lightrag.{sh,bat}
# 起好后这里改成实际地址;默认 http://localhost:9621
LIGHTRAG_URL=http://localhost:9621
# RAG 缓存 TTL 秒数(0=关;默认 300)。命中缓存可降低 LightRAG 压力。
LIGHTRAG_CACHE_TTL=300

# 微信小程序配置
# 熟人内测:用微信公众平台「测试号」https://mp.weixin.qq.com/debug/cgi-bin/sandboxinfo
# 拿到 wx9f4d1bbf3dxxxxx 形式的 appid + secret,免费、无需审核、真机扫码即可用
WX_APPID=your_appid_here
WX_SECRET=your_secret_here

# JWT配置
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI配置
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# 微信支付配置
# 变量名以 WXPAY_* 为准（config/index.js 读的就是这几个）。
# WXPAY_API_KEY 是 v2 商户 API 密钥,用于 /order/callback 验签;
# 不配 → 回调一律 503 拒绝(安全默认,绝不误判已支付)。
WXPAY_MCHID=your_mchid
WXPAY_API_KEY=your_pay_api_key
WXPAY_NOTIFY_URL=https://your-domain.com/api/v1/order/callback
# 证书路径(接统一下单 API 时用,当前 /pay 仍为占位实现)
WXPAY_CERT_PATH=./certs/apiclient_cert.pem
WXPAY_KEY_PATH=./certs/apiclient_key.pem

# Sentry 监控（可选；空 = 降级到 console.error 写日志，不发远端）
# 例：SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/123
SENTRY_DSN=
# 性能采样率 0.0~1.0；0 关闭 performance 监控，只上抛异常
SENTRY_TRACES_SAMPLE_RATE=0
# 可选 release tag，便于按版本聚合
SENTRY_RELEASE=
