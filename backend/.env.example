# 环境配置文件示例
# 复制此文件为 .env 并填入实际值

# 服务器配置
PORT=3000
NODE_ENV=development

# MongoDB配置
MONGODB_URL=mongodb://localhost:27017/bazi

# Redis配置
REDIS_URL=redis://localhost:6379

# 微信小程序配置
WX_APPID=your_appid_here
WX_SECRET=your_secret_here

# JWT配置
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI配置
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# 微信支付配置
WX_PAY_MCHID=your_mchid
WX_PAY_KEY=your_pay_key
WX_PAY_CERT_PATH=./certs/apiclient_cert.pem
WX_PAY_KEY_PATH=./certs/apiclient_key.pem
