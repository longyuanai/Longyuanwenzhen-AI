# 环境配置文件示例
# 复制此文件为 .env 并填入实际值

# 服务器配置
PORT=3000
NODE_ENV=development

# CORS 白名单（逗号分隔；'*' 全放；空 + NODE_ENV=production 拒绝所有跨域）
# 例：ALLOWED_ORIGINS=https://example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# AI 限流开关（1=关；空=开）。压测/联调时设 1 临时绕开
RATE_LIMIT_DISABLED=

# MongoDB配置
MONGODB_URL=mongodb://localhost:27017/bazi

# Redis配置
REDIS_URL=redis://localhost:6379

# 微信小程序配置
WX_APPID=your_appid_here
WX_SECRET=your_secret_here

# JWT配置
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI配置
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# 微信支付配置
WX_PAY_MCHID=your_mchid
WX_PAY_KEY=your_pay_key
WX_PAY_CERT_PATH=./certs/apiclient_cert.pem
WX_PAY_KEY_PATH=./certs/apiclient_key.pem

# Sentry 监控（可选；空 = 降级到 console.error 写日志，不发远端）
# 例：SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/123
SENTRY_DSN=
# 性能采样率 0.0~1.0；0 关闭 performance 监控，只上抛异常
SENTRY_TRACES_SAMPLE_RATE=0
# 可选 release tag，便于按版本聚合
SENTRY_RELEASE=
