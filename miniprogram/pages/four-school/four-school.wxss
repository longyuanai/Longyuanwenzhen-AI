/* pages/four-school/four-school.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5F7FA 0%, #FFFFFF 100%);
  padding-bottom: 200rpx;
}

/* 头部命盘卡 */
.header-card {
  margin: 30rpx;
  padding: 24rpx 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.header-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.bazi-string {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  letter-spacing: 4rpx;
  font-family: monospace;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E5E5E5;
  border-top-color: #4A90E2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.loading-hint {
  font-size: 22rpx;
  color: #999;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 30rpx;
}

.error-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  text-align: center;
}

.btn-retry {
  background: #4A90E2;
  color: #FFFFFF;
  border-radius: 40rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border: none;
}

/* 古籍命中统计 */
.sources-card {
  margin: 0 30rpx 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.sources-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.sources-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 12rpx;
}

.source-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.source-school {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.source-count {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A90E2;
}

.sources-total {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  border-top: 1rpx solid #F0F0F0;
  padding-top: 12rpx;
  margin-top: 8rpx;
}

/* 解读内容 */
.content-card {
  margin: 0 30rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  min-height: 600rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.rich-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
}

/* 免责声明 */
.disclaimer {
  margin: 30rpx;
  padding: 20rpx;
  background: rgba(255, 245, 230, 0.6);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
  text-align: center;
}

/* 底部付费入口 */
.footer-pay {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.footer-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.btn-pay {
  background: linear-gradient(135deg, #4A90E2 0%, #67C23A 100%);
  color: #FFFFFF;
  border-radius: 50rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

/* 联系客服弹窗(复用 analysis 的样式风格) */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #EEE;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
}

.price-info {
  text-align: center;
  margin-bottom: 24rpx;
}

.price-value {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
  color: #FF6B6B;
  line-height: 1.2;
}

.price-sub {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.features {
  background: #F5F7FA;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.feature-item {
  font-size: 26rpx;
  color: #666;
  line-height: 2;
}

.contact-block {
  background: #FFF8E7;
  border-radius: 10rpx;
  padding: 20rpx;
  text-align: center;
}

.contact-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.wechat-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 12rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.wechat-id {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  font-family: monospace;
}

.wechat-copy {
  font-size: 22rpx;
  color: #4A90E2;
  border: 1rpx solid #4A90E2;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.contact-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 30rpx;
}

.btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  background: #F5F5F5;
  color: #666;
  border: none;
}