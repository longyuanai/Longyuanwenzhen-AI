/* pages/profile/profile.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 用户信息 */
.user-section {
  margin: 30rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.user-text {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.user-id {
  font-size: 26rpx;
  color: #999;
}

/* 登录提示 */
.login-tip {
  margin: 30rpx;
  text-align: center;
  padding: 40rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #999;
}

/* 历史记录 */
.history-section {
  margin: 0 30rpx 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.clear-btn {
  font-size: 26rpx;
  color: #F5222D;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.history-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

/* 日期占左侧，性别与来源标签靠右成组 */
.history-date {
  font-size: 26rpx;
  color: #666;
  margin-right: auto;
}

/* 有备注名时由它领头，日期跟随其后 */
.history-label + .history-date {
  margin-right: auto;
}

.history-gender {
  font-size: 26rpx;
  color: #999;
}

/* 仅存在于本机的记录（匿名时排的盘 / 离线兜底），登录同步后不再出现 */
.history-local-tag {
  font-size: 22rpx;
  color: #ad6800;
  background: #fff7e6;
  border: 2rpx solid #ffd591;
  border-radius: 6rpx;
  padding: 0 10rpx;
  line-height: 32rpx;
}

.syncing-tip {
  font-size: 24rpx;
  color: #999;
  margin-left: auto;
  margin-right: 20rpx;
}

.history-bazi {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 关于 */
.about-section {
  margin: 0 30rpx;
}

.about-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.about-item:last-child {
  border-bottom: none;
}

.about-label {
  font-size: 28rpx;
  color: #666;
}

.about-value {
  font-size: 28rpx;
  color: #333;
}

/* 备注名：区分多张盘（"我自己" / "老王"），排在日期前面 */
.history-label {
  font-size: 26rpx;
  color: #4A90E2;
  font-weight: 500;
}

.history-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}

/* 意见反馈：可点条目，箭头提示可交互 */
.feedback-item {
  align-items: center;
}

.feedback-arrow {
  color: #4A90E2;
}
