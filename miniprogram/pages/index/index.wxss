/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #4A90E2 0%, #F5F5F5 30%);
}

/* Banner */
.banner {
  padding: 80rpx 40rpx 60rpx;
  text-align: center;
}

.banner-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.banner-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.banner-desc {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 用户信息 */
.user-section {
  margin: 0 30rpx 30rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.user-text {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.welcome {
  font-size: 28rpx;
  color: #999;
}

/* 登录区域 */
.login-section {
  margin: 0 30rpx 30rpx;
}

.login-tip {
  text-align: center;
  margin-bottom: 30rpx;
}

.tip-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.tip-desc {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.btn-login {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07C160;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 功能介绍 */
.features {
  margin: 0 30rpx 30rpx;
}

.feature-list {
  margin-top: 30rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  font-size: 48rpx;
  margin-right: 30rpx;
}

.feature-text {
  display: flex;
  flex-direction: column;
}

.feature-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.feature-desc {
  font-size: 26rpx;
  color: #999;
}

/* 快速开始 */
.action-section {
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.btn-start {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.btn-start:active {
  opacity: 0.9;
  transform: translateY(2rpx);
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}

/* 头像昵称填写（替代已失效的 getUserProfile）。
   登录后可选补充，不填不影响任何功能。 */
.profile-fill {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #eee;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

/* open-type="chooseAvatar" 的按钮要去掉默认外观，只留头像本身 */
.avatar-btn {
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #f5f5f5;
  line-height: normal;
}
.avatar-btn::after { border: none; }

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  display: block;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f8f8f8;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
}
