/* pages/paipan/paipan.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 表单 */
.form {
  margin: 30rpx;
}

.form-item {
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.required {
  color: #F5222D;
  margin-left: 8rpx;
}

/* 选择器 */
.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.picker-value {
  font-size: 32rpx;
  color: #333;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999;
}

/* 单选框 */
.radio-group {
  display: flex;
  gap: 40rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  color: #333;
}

.radio-item radio {
  margin-right: 12rpx;
}

/* 提示 */
.tips {
  margin: 0 30rpx 30rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 20rpx;
}

.tip-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-content text {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}

/* 提交按钮 */
.action-section {
  padding: 0 30rpx;
  margin-top: 40rpx;
}

.btn-submit {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.btn-submit:active {
  opacity: 0.9;
}
