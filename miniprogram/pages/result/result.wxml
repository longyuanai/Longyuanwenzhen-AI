<!--pages/result/result.wxml-->
<view class="container" wx:if="{{result}}">
  <!-- 降级提示：服务端排盘不可达时用了本地简化算法，起运年龄与大运区间会有偏差 -->
  <view class="fallback-tip" wx:if="{{isLocalFallback}}">
    当前为离线排盘结果，起运年龄与大运区间可能有偏差，联网后重新排盘可获得精确结果。
  </view>

  <!-- 真太阳时：填了出生地才出现。跨日时要说清楚，否则用户会以为日柱算错了 -->
  <view class="tst-tip" wx:if="{{trueSolarTime}}">
    <text class="tst-title">已按 {{trueSolarTime.place}} 真太阳时校正 {{trueSolarTime.offsetText}}</text>
    <text class="tst-detail">实际用于排盘的时刻：{{trueSolarTime.solarTimeText}}</text>
    <text class="tst-detail" wx:if="{{trueSolarTime.crossedDay}}">
      校正后跨越了日界，日柱与时柱均随之改变。
    </text>
  </view>

  <!-- 基本信息 -->
  <view class="info-section card">
    <view class="info-row">
      <text class="info-label">出生日期：</text>
      <text class="info-value">{{result.birthDate}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">出生时间：</text>
      <text class="info-value">{{result.birthTime}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">性别：</text>
      <text class="info-value">{{result.gender === 'male' ? '男' : '女'}}</text>
    </view>
  </view>

  <!-- 四柱八字 -->
  <view class="bazi-section card">
    <view class="section-title">四柱八字</view>
    <view class="pillars-container">
      <view class="pillar-item" wx:for="{{pillars}}" wx:key="name">
        <view class="pillar-name">{{item.name}}</view>
        <view class="pillar-content">
          <view class="pillar-gan">
            <text class="gan-text">{{item.gan}}</text>
            <text class="shishen-text">{{item.ganShiShen}}</text>
          </view>
          <view class="pillar-divider"></view>
          <view class="pillar-zhi">
            <text class="zhi-text">{{item.zhi}}</text>
            <text class="shishen-text">{{item.zhiShiShen}}</text>
          </view>
        </view>
        <view class="cang-gan" wx:if="{{item.cangGan.length > 0}}">
          <text class="cang-gan-label">藏干：</text>
          <text class="cang-gan-value">{{item.cangGan.join(' ')}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 五行信息 -->
  <view class="wuxing-section card">
    <view class="section-title">五行配置</view>
    <view class="wuxing-grid">
      <view class="wuxing-item">
        <text class="wuxing-label">年柱：</text>
        <text class="wuxing-value">{{result.wuxing.yearGan}}{{result.wuxing.yearZhi}}</text>
      </view>
      <view class="wuxing-item">
        <text class="wuxing-label">月柱：</text>
        <text class="wuxing-value">{{result.wuxing.monthGan}}{{result.wuxing.monthZhi}}</text>
      </view>
      <view class="wuxing-item">
        <text class="wuxing-label">日柱：</text>
        <text class="wuxing-value">{{result.wuxing.dayGan}}{{result.wuxing.dayZhi}}</text>
      </view>
      <view class="wuxing-item">
        <text class="wuxing-label">时柱：</text>
        <text class="wuxing-value">{{result.wuxing.hourGan}}{{result.wuxing.hourZhi}}</text>
      </view>
    </view>
  </view>

  <!-- 大运 -->
  <view class="dayun-section card">
    <view class="section-title">大运</view>
    <view class="dayun-info">
      <text class="dayun-direction">{{result.daYun.isForward ? '顺行' : '逆行'}}</text>
      <text class="dayun-start">起运年龄：{{result.daYun.startAge}}岁</text>
    </view>
    <view class="dayun-list">
      <view class="dayun-item" wx:for="{{result.daYun.daYunList}}" wx:key="ageRange">
        <view class="dayun-pillar">{{item.gan}}{{item.zhi}}</view>
        <view class="dayun-age">{{item.ageRange}}</view>
      </view>
    </view>
  </view>

  <!-- 神煞与命宫身宫。老版本后端不返回该字段时整块不渲染 -->
  <view class="shensha-section card" wx:if="{{shenSha}}">
    <view class="section-title">神煞 · 命宫身宫</view>

    <view class="palace-row">
      <view class="palace-item">
        <text class="palace-label">命宫</text>
        <text class="palace-value">{{shenSha.mingGong}}</text>
      </view>
      <view class="palace-item">
        <text class="palace-label">身宫</text>
        <text class="palace-value">{{shenSha.shenGong}}</text>
      </view>
      <view class="palace-item">
        <text class="palace-label">空亡</text>
        <text class="palace-value">{{shenSha.kongWang}}</text>
      </view>
    </view>

    <view class="ss-group" wx:if="{{shenSha.auspicious.length}}">
      <view class="ss-group-title">吉神</view>
      <view class="ss-item" wx:for="{{shenSha.auspicious}}" wx:key="name">
        <view class="ss-head">
          <text class="ss-name ss-name-good">{{item.name}}</text>
          <text class="ss-pillars">{{item.pillarText}}</text>
        </view>
        <text class="ss-meaning">{{item.meaning}}</text>
      </view>
    </view>

    <view class="ss-group" wx:if="{{shenSha.neutral.length}}">
      <view class="ss-group-title">其他</view>
      <view class="ss-item" wx:for="{{shenSha.neutral}}" wx:key="name">
        <view class="ss-head">
          <text class="ss-name">{{item.name}}</text>
          <text class="ss-pillars">{{item.pillarText}}</text>
        </view>
        <text class="ss-meaning">{{item.meaning}}</text>
      </view>
    </view>

    <view class="ss-empty" wx:if="{{!shenSha.auspicious.length && !shenSha.neutral.length}}">
      本盘无显著神煞命中。
    </view>

    <view class="ss-note">{{shenSha.note}}</view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button class="btn-analysis" bindtap="goToAnalysis">
      查看命理解读
    </button>
    <button class="btn-repaipan" bindtap="rePaipan">
      重新排盘
    </button>
  </view>
</view>
