/* pages/result/result.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 基本信息 */
.info-section {
  margin: 30rpx;
}

.info-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  width: 180rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* 四柱八字 */
.bazi-section {
  margin: 0 30rpx 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.pillars-container {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.pillar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pillar-name {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.pillar-content {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
}

.pillar-gan, .pillar-zhi {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
}

.gan-text, .zhi-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.shishen-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.pillar-divider {
  height: 2rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 10rpx 20rpx;
}

.cang-gan {
  margin-top: 16rpx;
  text-align: center;
}

.cang-gan-label {
  font-size: 22rpx;
  color: #999;
}

.cang-gan-value {
  font-size: 22rpx;
  color: #666;
}

/* 五行信息 */
.wuxing-section {
  margin: 0 30rpx 30rpx;
}

.wuxing-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.wuxing-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.wuxing-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 12rpx;
}

.wuxing-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 大运 */
.dayun-section {
  margin: 0 30rpx 30rpx;
}

.dayun-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.dayun-direction, .dayun-start {
  font-size: 26rpx;
  color: #666;
}

.dayun-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.dayun-item {
  flex: 0 0 calc(25% - 15rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.dayun-pillar {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.dayun-age {
  font-size: 22rpx;
  color: #999;
}

/* 操作按钮 */
.action-section {
  padding: 0 30rpx;
  display: flex;
  gap: 20rpx;
}

.btn-analysis {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-repaipan {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #ffffff;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 离线降级提示：本地简化算法的结果与服务端权威排盘会有偏差 */
.fallback-tip {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #fff7e6;
  border: 2rpx solid #ffd591;
  border-radius: 12rpx;
  color: #ad6800;
  font-size: 26rpx;
  line-height: 1.6;
}
