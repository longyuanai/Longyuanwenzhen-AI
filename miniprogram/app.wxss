/* app.wxss - 全局样式 */

/* 主题色 */
page {
  --primary-color: #4A90E2;
  --secondary-color: #7B68EE;
  --success-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #F5222D;
  --text-color: #333333;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --border-color: #E8E8E8;
  --background-color: #F5F5F5;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  color: var(--text-color);
  background-color: var(--background-color);
}

/* 通用容器 */
.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 标题样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

/* 按钮样式 */
.btn-primary {
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  background: #ffffff;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: 12rpx;
  padding: 22rpx 46rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}

/* 输入框样式 */
.input {
  background: #ffffff;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: var(--text-color);
}

.input:focus {
  border-color: var(--primary-color);
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: var(--border-color);
  margin: 30rpx 0;
}

/* 文本对齐 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

/* Flex布局 */
.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

/* 间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

/* 八字相关样式 */
.bazi-pillar {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  color: #ffffff;
  font-weight: bold;
}

.bazi-gan {
  font-size: 48rpx;
  margin-bottom: 20rpx;
}

.bazi-zhi {
  font-size: 48rpx;
}

/* 十神标签 */
.shishen-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 6rpx;
  font-size: 24rpx;
  margin: 4rpx;
}

/* 五行颜色 */
.wood { color: #52C41A; }
.fire { color: #F5222D; }
.earth { color: #D48806; }
.metal { color: #FAAD14; }
.water { color: #1890FF; }
